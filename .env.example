# Copy to `env.local` (the file docker-compose reads) and fill in real values.
# NEVER commit the filled-in file.

# --- Flask ---
FLASK_ENV=development
APP_MODE=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# --- Database (AWS RDS / MySQL) ---
DATABASE_HOST=
DATABASE_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=sehanDB

# --- Celery / Redis ---
REDIS_HOST=redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Kakao (OAuth login) ---
# CLIENT_ID is public; the SECRET must stay server-side only.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# --- Tason (kakao AlimTalk sending) ---
TASON_ID=
TASON_AUTH_KEY=

# --- Zoom (OAuth + webhook) ---
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Kollus FTP (recording upload) ---
FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# --- Term dates used by the scheduler ---
SEHAN_START_DATE=
SEHAN_END_DATE=
UPLOAD_FOLDER=/home/ubuntu/sehan_website/homework
