# http to https for dev flask server response server configuration
#
server {
	listen 80;
    	server_name dev.sehanib.kr;
    	return 301 https://$host$request_uri;  # Redirect HTTP to HTTPS
}

server {
	listen 443 ssl;
	server_name sehanib.kr www.sehanib.kr;

	# ssl certificate path
	ssl_certificate /etc/ssl/sehanib.kr/www_sehanib.kr_combined.crt;
	ssl_certificate_key /etc/ssl/sehanib.kr/www_sehanib.kr.key;

	root /home/ubuntu/sehan_website/dist;

	index index.html index.htm;

	location / {
		try_files $uri /index.html;

                client_max_body_size 100m;
	}

	location /api/ {
                rewrite ^/api(/.*)$ $1 break;
                proxy_pass http://127.0.0.1:5002;  # Flask's port
                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_cache_bypass $http_upgrade;
                client_max_body_size 100m;

		proxy_connect_timeout       240;
		proxy_send_timeout          240;
		proxy_read_timeout          240;
		send_timeout                240;

        }


}

